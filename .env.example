# Copy to .env.local and adjust. Restart `npm run dev` after changes.

# WebSocket URL of `npm run stt-proxy` on your LAN (phone must reach this host).
# VITE_GCP_STT_WS_URL=ws://192.168.1.10:8787

# PCM sample rate from Even host (often 16000 for 16-bit mono).
# VITE_STT_SAMPLE_RATE_HZ=16000

# BCP-47 language for Google STT.
# VITE_STT_LANGUAGE=en-US
